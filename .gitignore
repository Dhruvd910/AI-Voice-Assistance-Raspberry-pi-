# virtual Environments
venv/
.venv/
env/

#environment variables
.env

#ignore folder
assist/
faces/
piper/
tests/

#other ignore
__pycache__/
*.pyc
output.wav
*.tar.gz
chat_history.json
profiles.json
# runtime assets and logs
GIFS/
logs/

# mascot animation sources and generated frames
Animations/*.gif
Animations/cache/

# Per-student conversation history: personal to the child using the device.
history/

# Custom KG pictures are local content, but keep the README that explains them.
pictures/*
!pictures/README.md
history/*.progress.json

# Textbook PDFs are large, and they are somebody else's copyright. The
# catalogue that says where to fetch them from is small and worth keeping.
books/**/*.pdf
books/**/*.txt
!books/README.md
