# Copy to .env and fill in what you use. Everything is optional: with nothing set,
# the engine runs fully offline with the rule-based command parser.

# --- LLM (any OpenAI-compatible chat-completions API) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                 # or OPENROUTER_API_KEY
LLM_MODEL=google/gemini-2.5-flash
# LLM_TEMPERATURE=0.2

# --- Speech to text: none | openai_compatible | faster_whisper ---
STT_PROVIDER=none
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=                 # or GROQ_API_KEY
STT_MODEL=whisper-large-v3-turbo
# FASTER_WHISPER_MODEL=base

# --- Text to speech: none | cartesia | piper ---
TTS_PROVIDER=none
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-2
# PIPER_MODEL=/path/to/voice.onnx
# AUDIO_OUTPUT_DEVICE=default

# --- Wake word (needs requirements-voice.txt) ---
WAKEWORD=false
WAKEWORD_MODEL=hey_jarvis

# --- Rendering / memory ---
# MODEL_LOD=auto            # auto (low on a Pi) | high | low
# MEMORY_BUDGET_MB=600
# RENDER_WIDTH=560
# RENDER_HEIGHT=400
# DEPTH_PEELING=true
# FULLSCREEN=true           # default: true on a Pi

# --- Knowledge ---
# RAG_BACKEND=sqlite        # sqlite | chroma
# EMBEDDER=hashing          # hashing | sentence_transformers
# ENGINE_OFFLINE=false
